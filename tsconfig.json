{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@railsim/core": ["packages/core/src/index.ts"],
      "@railsim/core/*": ["packages/core/src/*"],
      "@railsim/data": ["packages/data/src/index.ts"],
      "@railsim/data/*": ["packages/data/src/*"],
      "@railsim/audio": ["packages/audio/src/index.ts"],
      "@railsim/audio/*": ["packages/audio/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "apps/*/src/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "**/dist"]
}
